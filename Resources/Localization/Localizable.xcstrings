            "state": "translated",
            "value": "macOS no ha permitido activar el arranque. Mueve Notchy a Aplicaciones y vuelve a intentarlo."
          }
        }
      }
    },
    "«%@» está en la Papelera.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is in the Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» está en la Papelera."
          }
        }
      }
    },
    "«Cualquier app» lee lo que suena en cualquier reproductor, también en el navegador. Si deja de funcionar, Notchy pasa sola a leer Spotify y Música.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Any App” reads what plays in any player, including the browser. If it stops working, Notchy switches to reading Spotify and Music on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Cualquier app» lee lo que suena en cualquier reproductor, también en el navegador. Si deja de funcionar, Notchy pasa sola a leer Spotify y Música."
          }
        }
      }
    },
