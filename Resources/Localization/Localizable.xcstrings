    "Automática usa MediaRemote (cualquier app, incluido el navegador) y pasa sola a AppleScript (Spotify y Música) si deja de funcionar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic uses MediaRemote (any app, including the browser) and switches to AppleScript (Spotify and Music) by itself if it stops working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automática usa MediaRemote (cualquier app, incluido el navegador) y pasa sola a AppleScript (Spotify y Música) si deja de funcionar."
          }
        }
      }
    },
