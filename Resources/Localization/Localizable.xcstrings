    "Anima el visualizador con la música que suena. No graba ni guarda nada. Se marca como concedido cuando Notchy recibe audio por primera vez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animates the visualizer with the music that's playing. Nothing is recorded or saved. It shows as granted once Notchy receives audio for the first time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima el visualizador con la música que suena. No graba ni guarda nada. Se marca como concedido cuando Notchy recibe audio por primera vez."
          }
        }
      }
    },
