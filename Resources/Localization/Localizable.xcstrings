    "Arrastra la imagen en la vista previa para encuadrarla y pellizca para acercarla. El fondo solo se reproduce con el panel abierto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the image in the preview to frame it and pinch to zoom. The background only plays while the panel is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la imagen en la vista previa para encuadrarla y pellizca para acercarla. El fondo solo se reproduce con el panel abierto."
