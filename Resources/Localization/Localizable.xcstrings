{
  "sourceLanguage": "es",
  "strings": {
    "%@ (copia)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (copy)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (copia)"
          }
        }
      }
    },
    "%@ No se ha podido escribir en el disco. Comprueba que queda espacio libre.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Notchy couldn't write to the disk. Check that there's free space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ No se ha podido escribir en el disco. Comprueba que queda espacio libre."
          }
        }
      }
    },
    "%@ de %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de %@"
          }
        }
      }
    },
    "%@ temas no se han podido leer y no aparecen en la lista.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ themes couldn't be read and aren't in the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ temas no se han podido leer y no aparecen en la lista."
          }
        }
      }
    },
    "%@ tiene %@:1 sobre el panel y no llega al mínimo para texto (4,5:1).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has %@:1 against the panel and doesn't reach the minimum for text (4.5:1)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene %@:1 sobre el panel y no llega al mínimo para texto (4,5:1)."
          }
        }
      }
    },
    "%@ tiene %@:1 sobre el panel. No llega al mínimo para texto (4,5:1) ni para barras e iconos (3:1).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has %@:1 against the panel. It doesn't reach the minimum for text (4.5:1) or for bars and icons (3:1)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene %@:1 sobre el panel. No llega al mínimo para texto (4,5:1) ni para barras e iconos (3:1)."
          }
        }
      }
    },
    "%@ tiene %@:1 sobre el panel. Sirve para barras e iconos (mínimo 3:1), pero no para texto (mínimo 4,5:1).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has %@:1 against the panel. It works for bars and icons (minimum 3:1), but not for text (minimum 4.5:1)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene %@:1 sobre el panel. Sirve para barras e iconos (mínimo 3:1), pero no para texto (mínimo 4,5:1)."
          }
        }
      }
    },
